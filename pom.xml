<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>lk.icbt.clinic</groupId>
    <artifactId>sunrise-dental-purejava</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <name>Sunrise Dental Clinic Management System</name>
    <description>
        Appointment and patient management system for Sunrise Dental Clinic.
        Deliberately built without an application framework: Jakarta Servlets
        and JSP for the web tier, plain JDBC for persistence. The only
        third-party libraries are Gson (JSON), BCrypt (password hashing) and
        the JUnit/Mockito test stack -- none of which run the application or
        manage its objects the way Spring's container would.
    </description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Matches Tomcat 11's Servlet spec (6.1), which is what Main.java's
             embedded server actually implements. Tomcat 10.1.x implements
             Servlet 6.0; nothing in this codebase uses a 6.1-only API, so
             the compiled WAR still deploys correctly to either version. -->
        <servlet.version>6.1.0</servlet.version>
        <jstl.version>3.0.1</jstl.version>
        <mysql.version>9.1.0</mysql.version>
        <gson.version>2.11.0</gson.version>
        <bcrypt.version>0.10.2</bcrypt.version>
        <junit.version>5.11.3</junit.version>
        <mockito.version>5.14.2</mockito.version>
        <assertj.version>3.26.3</assertj.version>
        <h2.version>2.3.232</h2.version>
        <tomcat.version>11.0.25</tomcat.version>
    </properties>

    <dependencies>

        <!-- ================================================================
             Jakarta EE platform APIs. These are the servlet/JSP specification
             interfaces that Tomcat implements — not a third-party framework.
             Writing a servlet is no more "using a framework" than writing a
             class that implements java.util.Comparator is.
             ================================================================ -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${servlet.version}</version>
            <scope>provided</scope> <!-- supplied by Tomcat at runtime -->
        </dependency>
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>${jstl.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>${jstl.version}</version>
        </dependency>

        <!-- ================================================================
             JDBC driver. Persistence is plain java.sql.* (Connection,
             PreparedStatement, ResultSet) via a hand-written DAO layer —
             no ORM, no entity manager, no annotations mapping classes to
             tables.
             ================================================================ -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
        </dependency>

        <!-- ================================================================
             Small, single-purpose libraries — not frameworks. Neither
             manages object lifecycle, wires dependencies, or intercepts
             method calls; both are called directly, like any other library
             method.
             ================================================================ -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
        <dependency>
            <groupId>at.favre.lib</groupId>
            <artifactId>bcrypt</artifactId>
            <version>${bcrypt.version}</version>
        </dependency>

        <!-- ================================================================
             Embedded Tomcat — IDE convenience only, not part of the
             deployed application. Used only by Main.java, so IntelliJ
             Community (which has no built-in "deploy WAR to Tomcat" run
             configuration — that is an Ultimate-only feature) can run this
             project with a plain click of the green ▶.

             Deliberately left at the default "compile" scope rather than
             "provided": IntelliJ's Maven importer does not reliably put
             provided-scope dependencies on a plain Application run
             configuration's classpath (confirmed by testing — Main.main()
             failed with NoClassDefFoundError despite compiling cleanly),
             so relying on that scope would make "click Run" work
             inconsistently across IDE versions and setups.

             These three jars are kept out of the packaged WAR by the
             <packagingExcludes> below instead, which achieves the same
             goal — the submitted/deployed artifact stays exactly as
             before, with no embedded server bundled inside it — without
             depending on a scope/IDE interaction that turned out not to
             be dependable.
             ================================================================ -->
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
            <version>${tomcat.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-jasper</artifactId>
            <version>${tomcat.version}</version>
        </dependency>

        <!-- ================================================================
             Testing only — a test runner and a mocking library, not part
             of the running application.
             ================================================================ -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- In-memory database for DAO tests that need a real JDBC connection
             without requiring a MySQL server on every developer machine. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>sunrise-dental</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <!-- Embedded Tomcat is a compile-scope dependency so
                         IntelliJ's Run button can find it (see the
                         dependency block above for why), but it must never
                         reach the deployed artifact. This is every jar it
                         pulls in transitively, confirmed with
                         mvn dependency:tree rather than guessed, since an
                         incomplete list here would silently under-exclude. -->
                    <packagingExcludes>
                        WEB-INF/lib/tomcat-embed-core-*.jar,
                        WEB-INF/lib/tomcat-embed-jasper-*.jar,
                        WEB-INF/lib/tomcat-embed-el-*.jar,
                        WEB-INF/lib/tomcat-annotations-api-*.jar,
                        WEB-INF/lib/ecj-*.jar
                    </packagingExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <excludedGroups>${excluded.test.groups}</excludedGroups>
                </configuration>
            </plugin>
            <!--
              No embedded-Tomcat Maven plugin is used to run this WAR. Every
              such plugin (tomcat7-maven-plugin, tomcat-maven-plugin) embeds
              an old Tomcat whose annotation scanner cannot parse the
              multi-release JARs and module-info.class files that come with
              modern dependencies on Jakarta EE 10 / Servlet 6.0 — it is a
              genuine version mismatch, not a workaround-able warning.

              Deploy the packaged WAR to a real Tomcat 10.1+ (or 11.x)
              instead; see README.md.
            -->
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>default-tests</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <excluded.test.groups>requires-mysql</excluded.test.groups>
            </properties>
        </profile>
        <profile>
            <id>mysql-it</id>
            <properties>
                <excluded.test.groups></excluded.test.groups>
            </properties>
        </profile>
    </profiles>

</project>
