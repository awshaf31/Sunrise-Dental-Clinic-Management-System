@startuml sequence-issue-bill
' ============================================================================
' Scenario C — Calculating and Issuing a Patient Bill
'
' Shows the Strategy and Factory patterns doing real work over a plain JDBC
' persistence layer -- no ORM cascade or entity-graph loading involved.
' ============================================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequence {
    ArrowColor #2F5560
    LifeLineBorderColor #5D7D87
    LifeLineBackgroundColor #E4F0F1
    ParticipantBorderColor #0F6E7E
    ParticipantBackgroundColor #E4F0F1
    ParticipantFontColor #12313A
    ActorBorderColor #12313A
    GroupBackgroundColor #E4F0F1
}
skinparam note {
    BorderColor #B5701F
    BackgroundColor #FBEEDD
}

actor "Nimali\n(Receptionist)" as User

box "servlet" #F7F9F9
    participant ":BillWebServlet" as Servlet
end box

box "service" #F7F9F9
    participant ":BillingService" as Service
end box

box "billing  <<Strategy + Factory>>" #F7F9F9
    participant ":BillingStrategyFactory" as Factory
    participant "strategy:RootCanalBilling" as Strategy
end box

box "dao" #F7F9F9
    participant ":JdbcBillDao" as BillDao
    participant ":JdbcAppointmentDao" as ApptDao
    participant ":JdbcClinicSettingDao" as SettingDao
end box

database "MySQL" as DB

User -> Servlet : POST /bills/APT-20260906-001
activate Servlet

Servlet -> Service : issueBill(appointmentNo, staffId)
activate Service

Service -> BillDao : findByAppointmentNo(no)
activate BillDao
BillDao -> DB : SELECT ... FROM bill b\nJOIN appointment a, patient p, dentist d,\ntreatment_type t, staff ib [5-way JOIN]\nWHERE a.appointment_no = ?
DB --> BillDao : empty
BillDao --> Service : Optional.empty()
deactivate BillDao

alt no bill has been raised yet

    Service -> ApptDao : findByAppointmentNo(no)
    activate ApptDao
    ApptDao -> DB : SELECT ... [4-way JOIN:\nappointment, patient, dentist, treatment_type]
    DB --> ApptDao : ResultSet
    ApptDao --> Service : appointment:Appointment
    deactivate ApptDao

    Service -> SettingDao : findByKey("CONSULTATION_FEE")
    activate SettingDao
    SettingDao -> DB : SELECT setting_value FROM clinic_setting\nWHERE setting_key = ?
    DB --> SettingDao : "1500.00"
    SettingDao --> Service : ClinicSetting
    deactivate SettingDao
    note right of Service
      Read from configuration, not hard-coded.
      A missing value fails loudly rather than
      quietly billing the patient nothing.
    end note

    Service -> Factory : strategyFor(ROOT_CANAL)
    activate Factory
    note right of Factory
      Looks the code up in a map built at
      construction from each strategy's
      appliesTo(). No switch statement to
      keep in step as treatments are added.
    end note
    Factory --> Service : strategy:BillingStrategy
    deactivate Factory

    Service -> Strategy : treatmentFee(25000.00)
    activate Strategy
    Strategy -> Strategy : baseFee + (baseFee × 0.10)
    note right of Strategy
      Root canal carries a 10% complexity
      surcharge. toCurrency() rounds to two
      places, so a surcharge can never
      produce a fraction of a cent.
    end note
    Strategy --> Service : 27500.00
    deactivate Strategy

    Service -> BillDao : save(new Bill(appointment, 1500.00, 27500.00, staff))
    activate BillDao
    BillDao -> DB : INSERT INTO bill\n(appointment_id, consultation_fee,\ntreatment_fee, total_amount, issued_by)
    DB --> BillDao : generated id
    BillDao --> Service : bill:Bill
    deactivate BillDao

else a bill already exists
    note right of Service
      The existing bill is returned unchanged.
      Reprinting a receipt must not create a
      second billable record, which would
      double-count the visit in sp_daily_revenue.
    end note
end

Service --> Servlet : Bill
deactivate Service
Servlet --> User : receipt.jsp rendered\n(consultation 1,500.00 + treatment 27,500.00 = 29,000.00)
deactivate Servlet

@enduml
