@startuml sequence-login
' ============================================================================
' Scenario B — Staff Login Authentication
' ============================================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequence {
    ArrowColor #2F5560
    LifeLineBorderColor #5D7D87
    LifeLineBackgroundColor #E4F0F1
    ParticipantBorderColor #0F6E7E
    ParticipantBackgroundColor #E4F0F1
    ParticipantFontColor #12313A
    ActorBorderColor #12313A
}
skinparam note {
    BorderColor #B5701F
    BackgroundColor #FBEEDD
}

actor "Nimali\n(Receptionist)" as User

box "servlet + filter" #F7F9F9
    participant ":LoginServlet" as Login
    participant "session:HttpSession" as Session
end box

box "service" #F7F9F9
    participant ":AuthService" as Auth
    participant ":PasswordHasher" as Hasher
end box

box "dao" #F7F9F9
    participant ":JdbcStaffDao" as StaffDao
end box

database "MySQL" as DB

User -> Login : POST /login (username, password)
activate Login

Login -> Auth : authenticate(username, password)
activate Auth

Auth -> StaffDao : findByUsernameAndActive(username)
activate StaffDao
StaffDao -> DB : SELECT * FROM staff\nWHERE username = ? AND active = TRUE
DB --> StaffDao : ResultSet (one row)
StaffDao --> Auth : Optional<Staff>
deactivate StaffDao

Auth -> Hasher : matches(password, staff.passwordHash)
activate Hasher
note right of Hasher
  BCrypt.verifyer().verify(...) -- re-hashes the
  candidate with the stored salt, compares in
  constant time. The stored hash is never reversed.
end note
Hasher --> Auth : true
deactivate Hasher

Auth --> Login : Staff
deactivate Auth

Login -> Session : invalidate() [old session, if any]
Login -> Session : getSession(true) [new session id]
Login -> Session : setAttribute("clinic.user", staff)
note right of Session
  A new session id is issued before the
  authenticated user is stored, so a session id
  observed before login cannot be reused to ride
  the authenticated session.
end note

Login --> User : 302 Redirect to /
deactivate Login

== Invalid credentials ==

User -> Login : POST /login (wrong password)
activate Login
Login -> Auth : authenticate(username, wrong)
activate Auth
Auth -> StaffDao : findByUsernameAndActive(username)
activate StaffDao
StaffDao --> Auth : Optional<Staff>
deactivate StaffDao
Auth -> Hasher : matches(wrong, staff.passwordHash)
activate Hasher
Hasher --> Auth : false
deactivate Hasher
Auth -->x Login : AuthenticationFailedException\n"Invalid username or password"
deactivate Auth
note right of Auth
  The same message is thrown whether the username
  was unknown or the password wrong, so the login
  form cannot be used to enumerate valid usernames.
end note
Login --> User : login page re-rendered with error,\npassword field cleared
deactivate Login

@enduml
